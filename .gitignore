# Published: source, tests, the README and DATA.md, the example and these settings. Everything else at the top level stays local
# (data/, outputs/, external/, checkpoints/, artifacts/: links or folders for data and results).
/*
!/.gitignore
!/README.md
!/pytest.ini
!/neuroworld/
!/tests/
!/DATA.md
!/examples/

